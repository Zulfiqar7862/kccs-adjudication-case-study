{
  "title": "Adjudication operations \u2014 proposed metrics",
  "uid": "adjudication-ops",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "Europe/Berlin",
  "refresh": "30s",
  "tags": [
    "adjudication",
    "proposed"
  ],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Open obligations",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(adjudication_open_obligations)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Overdue obligations",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(adjudication_overdue_obligations)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Minimum deadline slack (seconds)",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "min(adjudication_deadline_slack_seconds)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Evidence-gap rate",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(rate(adjudication_evidence_gaps_total[15m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Timer heartbeat age",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "max(time() - adjudication_timer_last_success_timestamp_seconds)",
          "refId": "A"
        }
      ]
    }
  ]
}
